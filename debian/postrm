#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "purge" ]; then
    # The config is generated by postinst (not a conffile), so dpkg does not
    # remove it on purge by itself.
    rm -rf /etc/orbiq_system_monitor
    if [ -e /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_purge
    fi
fi

exit 0
